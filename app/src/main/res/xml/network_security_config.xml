<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Zero-Trust Hardened Network Security Configuration.
      Explicitly declares certificate trust anchors and confines cleartext endpoints.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
