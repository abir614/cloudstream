<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Data plane: media streams and scraping sources may require cleartext HTTP -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Control plane & Secure Infrastructure: updates, manifests, repositories & DoH resolvers require strict HTTPS and system CAs -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">quad9.net</domain>
        <domain includeSubdomains="true">cloudflare-dns.com</domain>
        <domain includeSubdomains="true">dns.google</domain>
        <domain includeSubdomains="true">adguard-dns.com</domain>
        <domain includeSubdomains="true">dns.sb</domain>
        <domain includeSubdomains="true">cira.ca</domain>
        <domain includeSubdomains="true">workers.dev</domain>

        <!-- User Authentication & Sync Infrastructure: strictly forbid cleartext HTTP -->
        <domain includeSubdomains="true">myanimelist.net</domain>
        <domain includeSubdomains="true">anilist.co</domain>
        <domain includeSubdomains="true">kitsu.io</domain>
        <domain includeSubdomains="true">simkl.com</domain>
        <domain includeSubdomains="true">trakt.tv</domain>
        <domain includeSubdomains="true">opensubtitles.com</domain>
        <domain includeSubdomains="true">opensubtitles.org</domain>
        <domain includeSubdomains="true">subdl.com</domain>
        <domain includeSubdomains="true">addic7ed.com</domain>
        <domain includeSubdomains="true">subsource.net</domain>
        <domain includeSubdomains="true">animeskip.com</domain>
        <domain includeSubdomains="true">themoviedb.org</domain>
        <domain includeSubdomains="true">tmdb.org</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Debug builds only: permit user certificates for local proxy inspection -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
