<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep 3D ambient drop-shadow halo for 1.5x pop-out depth -->
    <item
        android:bottom="-4dp"
        android:left="-4dp"
        android:right="-4dp"
        android:top="-4dp">
        <shape>
            <stroke
                android:width="7.5dp"
                android:color="#99000000" />
            <corners
                android:bottomLeftRadius="@dimen/rounded_image_radius"
                android:bottomRightRadius="@dimen/rounded_image_radius"
                android:topLeftRadius="@dimen/rounded_image_radius"
                android:topRightRadius="@dimen/rounded_image_radius" />
        </shape>
    </item>
    <!-- Outer high-contrast shadow edge (isolates selector on white/bright or busy posters) -->
    <item>
        <shape>
            <stroke
                android:width="6.0dp"
                android:color="#E6000000" />
            <corners
                android:bottomLeftRadius="@dimen/rounded_image_radius"
                android:bottomRightRadius="@dimen/rounded_image_radius"
                android:topLeftRadius="@dimen/rounded_image_radius"
                android:topRightRadius="@dimen/rounded_image_radius" />
        </shape>
    </item>
    <!-- Middle bold radiant primary accent stroke (prominent TV focus indicator) -->
    <item
        android:bottom="1.0dp"
        android:left="1.0dp"
        android:right="1.0dp"
        android:top="1.0dp">
        <shape>
            <stroke
                android:width="4.5dp"
                android:color="?attr/colorPrimary" />
            <corners
                android:bottomLeftRadius="@dimen/rounded_image_radius"
                android:bottomRightRadius="@dimen/rounded_image_radius"
                android:topLeftRadius="@dimen/rounded_image_radius"
                android:topRightRadius="@dimen/rounded_image_radius" />
        </shape>
    </item>
    <!-- Inner crisp highlight edge (ensures crystal clear visibility on dark posters) -->
    <item
        android:bottom="2.0dp"
        android:left="2.0dp"
        android:right="2.0dp"
        android:top="2.0dp">
        <shape>
            <stroke
                android:width="1.8dp"
                android:color="#F0FFFFFF" />
            <corners
                android:bottomLeftRadius="@dimen/rounded_image_radius"
                android:bottomRightRadius="@dimen/rounded_image_radius"
                android:topLeftRadius="@dimen/rounded_image_radius"
                android:topRightRadius="@dimen/rounded_image_radius" />
        </shape>
    </item>
</layer-list>
