<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer high-contrast shadow halo (isolates selector on white/bright or busy posters) -->
    <item>
        <shape>
            <stroke
                android:width="5.5dp"
                android:color="#E6000000" />
            <corners
                android:bottomLeftRadius="@dimen/rounded_image_radius"
                android:bottomRightRadius="@dimen/rounded_image_radius"
                android:topLeftRadius="@dimen/rounded_image_radius"
                android:topRightRadius="@dimen/rounded_image_radius" />
        </shape>
    </item>
    <!-- Middle bold radiant primary accent stroke (prominent TV focus indicator) -->
    <item
        android:bottom="0.8dp"
        android:left="0.8dp"
        android:right="0.8dp"
        android:top="0.8dp">
        <shape>
            <stroke
                android:width="4.0dp"
                android:color="?attr/colorPrimary" />
            <corners
                android:bottomLeftRadius="@dimen/rounded_image_radius"
                android:bottomRightRadius="@dimen/rounded_image_radius"
                android:topLeftRadius="@dimen/rounded_image_radius"
                android:topRightRadius="@dimen/rounded_image_radius" />
        </shape>
    </item>
    <!-- Inner crisp highlight edge (ensures crystal clear visibility on dark posters) -->
    <item
        android:bottom="1.8dp"
        android:left="1.8dp"
        android:right="1.8dp"
        android:top="1.8dp">
        <shape>
            <stroke
                android:width="1.5dp"
                android:color="#F0FFFFFF" />
            <corners
                android:bottomLeftRadius="@dimen/rounded_image_radius"
                android:bottomRightRadius="@dimen/rounded_image_radius"
                android:topLeftRadius="@dimen/rounded_image_radius"
                android:topRightRadius="@dimen/rounded_image_radius" />
        </shape>
    </item>
</layer-list>
