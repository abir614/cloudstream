<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer high-contrast dark border (separates stroke from white / bright backgrounds) -->
    <item>
        <shape>
            <stroke
                android:width="3.5dp"
                android:color="#CC000000" />
            <corners
                android:bottomLeftRadius="@dimen/rounded_button_radius"
                android:bottomRightRadius="@dimen/rounded_button_radius"
                android:topLeftRadius="@dimen/rounded_button_radius"
                android:topRightRadius="@dimen/rounded_button_radius" />
        </shape>
    </item>
    <!-- Inner radiant primary accent stroke (modern TV focus indicator) -->
    <item
        android:bottom="0.5dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0.5dp">
        <shape>
            <stroke
                android:width="2.5dp"
                android:color="?attr/colorPrimary" />
            <corners
                android:bottomLeftRadius="@dimen/rounded_button_radius"
                android:bottomRightRadius="@dimen/rounded_button_radius"
                android:topLeftRadius="@dimen/rounded_button_radius"
                android:topRightRadius="@dimen/rounded_button_radius" />
        </shape>
    </item>
</layer-list>